# Authentication
#
# Password used to access protected dashboard management features.
AUTH_PASSWORD=change-me

# Secret used to sign authentication/session data.
# Generate a long random value for production.
AUTH_SECRET=change-me-to-a-long-random-secret


# Database
#
# Optional. If omitted, the application uses:
# data/rides.db
#
# RIDES_DB_PATH=/absolute/path/to/rides.db

# Optional Peloton username displayed in the dashboard header.
# Do not include the @ symbol.
NEXT_PUBLIC_PELOTON_USERNAME=your_username

# Weekly Summary
#
# Token required to access the weekly summary API.
WEEKLY_SUMMARY_TOKEN=change-me

# Token used for the public HTML weekly summary URL.
WEEKLY_SUMMARY_HTML_TOKEN=change-me